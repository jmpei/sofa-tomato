+
+describe("export", () => {
+  test("localDay is the local calendar day, not the UTC day", () => {
+    assert.equal(localDay(new Date(2026, 9, 29, 21, 0).getTime()), "2026-10-29");
+    assert.equal(localDay(new Date(2026, 0, 5, 0, 30).getTime()), "2026-01-05");
+  });
+
+  test("exportFileName names the file with what it holds and the local day", () => {
+    const now = new Date(2026, 9, 29, 21, 0).getTime();
+    assert.equal(exportFileName("movies", "csv", now), "sofa-tomato-movies-2026-10-29.csv");
+  });
+
+  test("csvCell quotes commas, quotes and line breaks, and defuses formulas", () => {
+    assert.equal(csvCell("Up"), "Up");
+    assert.equal(csvCell("Crash, Burn"), '"Crash, Burn"');
+    assert.equal(csvCell('Say "hi"'), '"Say ""hi"""');
+    assert.equal(csvCell("a\nb"), '"a\nb"');
+    assert.equal(csvCell("=1+1"), "'=1+1");
+    assert.equal(csvCell("-1"), "'-1");
+    assert.equal(csvCell(null), "");
+    assert.equal(csvCell(1999), "1999");
+  });
+
+  test("moviesToCsv has a header, then every movie newest first", () => {
+    const a = watched("Arrival", ["Made me think", "Slow, but good"], { loved: true, now: 1000 });
+    const b = later("Dune", 2000);
+    const lines = moviesToCsv([a, b]).split("\r\n");
+    assert.equal(lines[0], CSV_COLUMNS.join(","));
+    assert.match(lines[1], /^Dune,watchlist,no,,/);
+    assert.match(lines[2], /^Arrival,watched,yes,"Made me think; Slow, but good",/);
+    assert.deepEqual(lines.slice(3), [""]);
+  });
+
+  test("moviesToCsv includes details when known and leaves them blank when not", () => {
+    const info = readInfo({ year: 2016, runtimeMinutes: 116, certificate: "PG-13", plot: "Aliens.", director: ["Denis Villeneuve"], stars: ["Amy Adams", "Jeremy Renner"] });
+    const now = new Date(2026, 9, 29, 21, 0).getTime();
+    const withInfo = { ...watched("Arrival", ["Made me think"], { now }), info };
+    const [, row] = moviesToCsv([withInfo]).split("\r\n");
+    assert.equal(row, "Arrival,watched,no,Made me think,2016,116,PG-13,Aliens.,Denis Villeneuve,Amy Adams; Jeremy Renner,2026-10-29,2026-10-29");
+    const [, blank] = moviesToCsv([later("Dune", 0)]).split("\r\n");
+    assert.equal(blank, "Dune,watchlist,no,,,,,,,,,");
+  });
+
+  test("moviesToCsv of nothing is just the header", () => {
+    assert.equal(moviesToCsv([]), `${CSV_COLUMNS.join(",")}\r\n`);
+  });
+});
