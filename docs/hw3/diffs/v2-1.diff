diff --git a/src/core.js b/src/core.js
index 8e739b8..be58f93 100644
--- a/src/core.js
+++ b/src/core.js
@@ -600,3 +600,52 @@ export function formatDate(timestamp, now = Date.now(), locale) {
     ...(sameYear ? {} : { year: "numeric" }),
   });
 }
+
+// ---------- Export ----------
+
+// The person's local calendar day as YYYY-MM-DD (not the UTC day).
+export function localDay(timestamp) {
+  const d = new Date(timestamp);
+  const pad = (n) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+// "sofa-tomato-movies-2026-10-29.csv"
+export function exportFileName(what, ext, now = Date.now()) {
+  return `sofa-tomato-${what}-${localDay(now)}.${ext}`;
+}
+
+// One CSV cell. Quotes when needed, and a leading = + - @ gets a ' in front
+// so a spreadsheet never runs a movie title as a formula.
+export function csvCell(value) {
+  let text = String(value ?? "");
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
+}
+
+export const CSV_COLUMNS = [
+  "Title", "Status", "Loved", "Tags", "Year", "Runtime (min)", "Rating",
+  "Plot", "Director", "Stars", "Added", "Watched",
+];
+
+// All movies, watched and watchlist, newest first. Rows end with CRLF.
+export function moviesToCsv(movies) {
+  const rows = sortNewestFirst(movies).map((m) => {
+    const info = m.info?.found ? m.info : null;
+    return [
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      info?.year ?? "",
+      info?.runtimeMinutes ?? "",
+      info?.certificate ?? "",
+      info?.plot ?? "",
+      info?.director.join("; ") ?? "",
+      info?.stars.join("; ") ?? "",
+      m.createdAt ? localDay(m.createdAt) : "",
+      m.watchedAt ? localDay(m.watchedAt) : "",
+    ];
+  });
+  return [CSV_COLUMNS, ...rows].map((r) => r.map(csvCell).join(",")).join("\r\n") + "\r\n";
+}
