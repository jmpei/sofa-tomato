--- a/src/core.js
+++ b/src/core.js
@@ -600,3 +600,54 @@ export function formatDate(timestamp, now = Date.now(), locale) {
     ...(sameYear ? {} : { year: "numeric" }),
   });
 }
+
+// ---------- Export ----------
+
+const pad2 = (n) => String(n).padStart(2, "0");
+
+// The person's local calendar day as YYYY-MM-DD (never the UTC day).
+export function localDay(timestamp = Date.now()) {
+  const d = new Date(timestamp);
+  return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`;
+}
+
+// Name for a file the app gives the user: sofa-tomato-movies-2026-10-29.csv
+export function exportFileName(what, ext, now = Date.now()) {
+  return `sofa-tomato-${what}-${localDay(now)}.${ext}`;
+}
+
+export const CSV_COLUMNS = [
+  "Title", "Status", "Loved", "Tags", "Added", "Watched", "Watched with",
+  "Year", "Runtime (min)", "Rating", "Director", "Stars", "Plot",
+];
+
+// One CSV field. Quotes anything with a comma, quote or line break, and
+// prefixes = + - @ with an apostrophe so a spreadsheet won't run it as a formula.
+function csvField(value) {
+  let text = value == null ? "" : String(value);
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replaceAll('"', '""')}"` : text;
+}
+
+// Every movie (watched and watchlist), newest first, as CSV text with CRLF rows.
+export function moviesToCsv(movies, nameOf = (id) => id) {
+  const rows = sortNewestFirst(movies).map((m) => {
+    const info = m.info?.found ? m.info : null;
+    return [
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      localDay(m.createdAt),
+      m.watchedAt == null ? "" : localDay(m.watchedAt),
+      m.watchedWith.map((w) => nameOf(w.with)).join("; "),
+      info?.year ?? "",
+      info?.runtimeMinutes ?? "",
+      info?.certificate ?? "",
+      info ? info.director.join("; ") : "",
+      info ? info.stars.join("; ") : "",
+      info?.plot ?? "",
+    ];
+  });
+  return [CSV_COLUMNS, ...rows].map((r) => r.map(csvField).join(",")).join("\r\n") + "\r\n";
+}
