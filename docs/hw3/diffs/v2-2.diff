+
+describe("export to CSV", () => {
+  test("the day and file name use the local day, not the UTC day", () => {
+    const late = new Date(2026, 9, 29, 21, 0).getTime(); // 9 pm local
+    assert.equal(localDay(late), "2026-10-29");
+    assert.equal(exportFileName("movies", "csv", late), "sofa-tomato-movies-2026-10-29.csv");
+    assert.equal(localDay(new Date(2026, 0, 5, 0, 30).getTime()), "2026-01-05");
+  });
+
+  test("one header row, then watched and watchlist movies newest first", () => {
+    const a = watched("Arrival", ["Made me think", "Slow"], { now: new Date(2026, 9, 1, 12).getTime(), loved: true });
+    const b = later("Dune", new Date(2026, 9, 5, 12).getTime());
+    const lines = moviesToCsv([a, b]).trimEnd().split("\r\n");
+    assert.equal(lines[0], CSV_COLUMNS.join(","));
+    assert.equal(lines.length, 3);
+    assert.match(lines[1], /^Dune,watchlist,no,,2026-10-05,,/);
+    assert.match(lines[2], /^Arrival,watched,yes,Made me think; Slow,2026-10-01,2026-10-01,/);
+  });
+
+  test("details and who you watched with are included", () => {
+    const m = {
+      ...watched("Arrival", ["Slow"]),
+      watchedWith: [{ with: "u_maya", at: 1 }],
+      info: readInfo({ year: 2016, runtimeMinutes: 116, certificate: "PG-13", plot: "Aliens land.", director: ["Denis Villeneuve"], stars: ["Amy Adams", "Jeremy Renner"] }),
+    };
+    const row = moviesToCsv([m], (id) => (id === "u_maya" ? "Maya" : id)).split("\r\n")[1];
+    assert.ok(row.endsWith(",Maya,2016,116,PG-13,Denis Villeneuve,Amy Adams; Jeremy Renner,Aliens land."));
+  });
+
+  test("commas, quotes and line breaks are quoted; formulas are defused", () => {
+    const quoted = watched('Hello, "World"', ["Slow"]);
+    assert.ok(moviesToCsv([quoted]).includes('"Hello, ""World""",watched'));
+    const formula = watched("=SUM(A1)", ["Slow"]);
+    assert.ok(moviesToCsv([formula]).includes("\r\n'=SUM(A1),watched"));
+    const broken = { ...quoted, tags: ["a\nb"] };
+    assert.ok(moviesToCsv([broken]).includes('"a\nb"'));
+  });
+
+  test("no movies gives just the header; missing details give empty cells", () => {
+    assert.equal(moviesToCsv([]), CSV_COLUMNS.join(",") + "\r\n");
+    const row = moviesToCsv([later("Dune")]).split("\r\n")[1];
+    assert.ok(row.endsWith(",,,,,,"));
+  });
+});
