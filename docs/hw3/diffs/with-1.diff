+
+describe("export to CSV", () => {
+  test("csvCell quotes commas, quotes and newlines, and defuses formulas", () => {
+    assert.equal(csvCell("plain"), "plain");
+    assert.equal(csvCell('Say "hi", ok'), '"Say ""hi"", ok"');
+    assert.equal(csvCell("two\nlines"), '"two\nlines"');
+    assert.equal(csvCell("=SUM(A1)"), "'=SUM(A1)");
+    assert.equal(csvCell(null), "");
+    assert.equal(csvCell(1999), "1999");
+  });
+
+  test("moviesToCsv with no movies is just the header", () => {
+    assert.equal(moviesToCsv([]), `${CSV_COLUMNS.join(",")}\r\n`);
+  });
+
+  test("moviesToCsv lists watched and watchlist movies, newest first", () => {
+    const a = watched("Arrival", ["Made me cry", "Slow, but good"], { now: Date.UTC(2026, 9, 1), loved: true });
+    const b = later('The "Room"', Date.UTC(2026, 9, 20));
+    const lines = moviesToCsv([a, b]).trimEnd().split("\r\n");
+    assert.equal(lines.length, 3);
+    assert.equal(lines[1], '"The ""Room""",watchlist,no,,2026-10-20,,,,,,,,');
+    assert.equal(lines[2], 'Arrival,watched,yes,"Made me cry; Slow, but good",2026-10-01,2026-10-01,,,,,,,');
+  });
+
+  test("moviesToCsv includes details and names who you watched with", () => {
+    const m = {
+      ...watched("Heat", ["Tense"], { now: Date.UTC(2026, 0, 5) }),
+      watchedWith: [{ with: "u_maya", at: 1 }, { with: "u_maya", at: 2 }],
+      info: readInfo({ year: 1995, runtimeMinutes: 170, certificate: "R", plot: "Cops, robbers.", director: ["Michael Mann"], stars: ["Al Pacino", "Robert De Niro"] }),
+    };
+    const row = moviesToCsv([m], (id) => (id === "u_maya" ? "Maya" : id)).split("\r\n")[1];
+    assert.equal(row, 'Heat,watched,no,Tense,2026-01-05,2026-01-05,Maya,1995,170,R,Michael Mann,Al Pacino; Robert De Niro,"Cops, robbers."');
+  });
+
+  test("moviesToCsv leaves detail columns empty when details are missing or not found", () => {
+    const m = { ...watched("Heat", ["Tense"]), info: { found: false } };
+    assert.match(moviesToCsv([m]), /,,,,,,\r\n$/);
+  });
+});
