+// ---------- Export ----------
+
+export const CSV_COLUMNS = [
+  "Title", "Status", "Loved", "Tags", "Added", "Watched", "Watched with",
+  "Year", "Runtime (min)", "Rating", "Director", "Stars", "Plot",
+];
+
+// #3: one cell, quoted when needed. A leading = + - @ (or tab/CR) would run as a
+// formula in Excel or Sheets, and titles come from a shared db, so defuse it.
+export function csvCell(value) {
+  let text = value == null ? "" : String(value);
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+const isoDay = (timestamp) => (Number.isFinite(timestamp) ? new Date(timestamp).toISOString().slice(0, 10) : "");
+
+// #3: every movie, watched and watchlist, as CSV text (CRLF rows, header first).
+// Newest first, like the Movies page. nameOf turns a person's id into a name.
+export function moviesToCsv(movies, nameOf = (id) => id) {
+  const rows = sortNewestFirst(movies).map((m) => {
+    const info = m.info?.found ? m.info : null;
+    return [
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      isoDay(m.createdAt),
+      m.status === "watched" ? isoDay(m.watchedAt ?? m.createdAt) : "",
+      [...new Set(m.watchedWith.map((w) => nameOf(w.with)))].join("; "),
+      info?.year,
+      info?.runtimeMinutes,
+      info?.certificate,
+      info?.director.join("; "),
+      info?.stars.join("; "),
+      info?.plot,
+    ];
+  });
+  return [CSV_COLUMNS, ...rows].map((r) => r.map(csvCell).join(",")).join("\r\n") + "\r\n";
+}
+
