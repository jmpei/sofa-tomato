@@ -600,3 +600,47 @@ export function formatDate(timestamp, now = Date.now(), locale) {
     ...(sameYear ? {} : { year: "numeric" }),
   });
 }
+
+// ---------- Export ----------
+
+export const CSV_COLUMNS = [
+  "Title", "Status", "Loved", "Tags", "Date", "Watched with",
+  "Year", "Runtime (min)", "Rating", "Director", "Stars", "Plot",
+];
+
+// One CSV cell. Quotes only when needed. A leading = + - @ would run as a
+// formula in Excel or Sheets, and titles are free text, so defuse it with '.
+export function csvCell(value) {
+  let text = value == null ? "" : String(value);
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+const isoDay = (timestamp) => (Number.isFinite(timestamp) ? new Date(timestamp).toISOString().slice(0, 10) : "");
+
+// All movies, watched and watchlist, newest first, as CSV text (CRLF rows).
+// `nameOf` turns a person's id into a display name.
+export function moviesToCsv(movies, nameOf = (id) => id) {
+  const lines = [CSV_COLUMNS.map(csvCell).join(",")];
+  for (const m of sortNewestFirst(movies)) {
+    const info = m.info?.found ? m.info : null;
+    const date = m.status === "watched" ? (m.watchedAt ?? m.createdAt) : m.createdAt;
+    lines.push([
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      isoDay(date),
+      m.watchedWith.map((w) => nameOf(w.with)).join("; "),
+      info?.year ?? "",
+      info?.runtimeMinutes ?? "",
+      info?.certificate ?? "",
+      info?.director.join("; ") ?? "",
+      info?.stars.join("; ") ?? "",
+      info?.plot ?? "",
+    ].map(csvCell).join(","));
+  }
+  return lines.join("\r\n") + "\r\n";
+}
+
+export const csvFilename = (now = Date.now()) => `sofa-tomato-movies-${isoDay(now)}.csv`;
