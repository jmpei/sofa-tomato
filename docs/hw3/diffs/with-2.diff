+
+describe("Export CSV", () => {
+  test("a cell is quoted only when it needs to be", () => {
+    assert.equal(csvCell("Alien"), "Alien");
+    assert.equal(csvCell('Say "hi", Bob'), '"Say ""hi"", Bob"');
+    assert.equal(csvCell("two\nlines"), '"two\nlines"');
+    assert.equal(csvCell(null), "");
+    assert.equal(csvCell(1999), "1999");
+  });
+
+  test("a cell that would run as a spreadsheet formula is defused", () => {
+    assert.equal(csvCell("=SUM(A1)"), "'=SUM(A1)");
+    assert.equal(csvCell("@cmd"), "'@cmd");
+    assert.equal(csvCell("-1"), "'-1");
+  });
+
+  test("watched and watchlist movies both export, newest first, under a header row", () => {
+    const old = watched("Alien", ["Scary"], { now: Date.UTC(2026, 0, 5) });
+    const fresh = watched("Heat", ["Great"], { now: Date.UTC(2026, 5, 9), loved: true });
+    const saved = later("Dune", Date.UTC(2026, 2, 1));
+    const lines = moviesToCsv([old, saved, fresh]).split("\r\n");
+    assert.equal(lines[0], CSV_COLUMNS.join(","));
+    assert.match(lines[1], /^Heat,watched,yes,Great,2026-06-09,/);
+    assert.match(lines[2], /^Dune,watchlist,no,,2026-03-01,/);
+    assert.match(lines[3], /^Alien,watched,no,Scary,2026-01-05,/);
+    assert.equal(lines[4], "");
+    assert.equal(lines.length, 5);
+  });
+
+  test("details, tags and who you watched with come out as readable text", () => {
+    const m = {
+      ...watched("Heat, 1995", ["Great", "Long"], { now: Date.UTC(2026, 0, 5) }),
+      watchedWith: [{ with: "u_sam", at: 1 }],
+      info: readInfo({ year: 1995, runtimeMinutes: 170, certificate: "R", plot: "Cops and robbers.", director: ["Michael Mann"], stars: ["Al Pacino", "Robert De Niro"] }),
+    };
+    const line = moviesToCsv([m], (id) => (id === "u_sam" ? "Sam" : id)).split("\r\n")[1];
+    assert.equal(line, '"Heat, 1995",watched,no,Great; Long,2026-01-05,Sam,1995,170,R,Michael Mann,Al Pacino; Robert De Niro,Cops and robbers.');
+  });
+
+  test("an empty log exports just the header", () => {
+    assert.equal(moviesToCsv([]), `${CSV_COLUMNS.join(",")}\r\n`);
+  });
+
+  test("a movie with no details or a bad date leaves those cells empty", () => {
+    const m = { ...later("Dune"), createdAt: NaN, info: { found: false } };
+    assert.equal(moviesToCsv([m]).split("\r\n")[1], "Dune,watchlist,no,,,,,,,,,");
+  });
+
+  test("the file name carries the day", () => {
+    assert.equal(csvFilename(Date.UTC(2026, 9, 29, 12)), "sofa-tomato-movies-2026-10-29.csv");
+  });
+});
