+function downloadCsv(movies) {
+  const url = URL.createObjectURL(new Blob(["﻿", moviesToCsv(movies)], { type: "text/csv;charset=utf-8" }));
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = "my-movies.csv";
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
