+// ---------- CSV export ----------
+
+const CSV_COLUMNS = ["Title", "Status", "Loved", "Tags", "Year", "Runtime (minutes)", "Rating", "Director", "Stars", "Plot", "Added", "Watched"];
+
+// One CSV field. Quotes anything with a comma, quote or line break, and
+// prefixes a quote to text a spreadsheet would run as a formula.
+function csvField(value) {
+  let text = String(value ?? "");
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+const isoDate = (t) => (Number.isFinite(t) && t > 0 ? new Date(t).toISOString().slice(0, 10) : "");
+
+// Every movie, watched and watchlist, as CSV text (newest first, CRLF rows).
+export function moviesToCsv(movies) {
+  const rows = sortNewestFirst(movies).map((m) => {
+    const info = m.info?.found ? m.info : null;
+    return [
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      info?.year ?? "",
+      info?.runtimeMinutes ?? "",
+      info?.certificate ?? "",
+      info?.director.join("; ") ?? "",
+      info?.stars.join("; ") ?? "",
+      info?.plot ?? "",
+      isoDate(m.createdAt),
+      m.status === "watched" ? isoDate(m.watchedAt ?? m.createdAt) : "",
+    ];
+  });
+  return [CSV_COLUMNS, ...rows].map((r) => r.map(csvField).join(",")).join("\r\n") + "\r\n";
+}
