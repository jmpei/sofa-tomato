+describe("moviesToCsv", () => {
+  test("header only for no movies", () => {
+    const lines = moviesToCsv([]).split("\r\n");
+    assert.equal(lines[0], "Title,Status,Loved,Tags,Year,Runtime (minutes),Rating,Director,Stars,Plot,Added,Watched");
+    assert.equal(lines.length, 2);
+  });
+
+  test("includes watched and watchlist movies with their details", () => {
+    const info = readInfo({ year: 2010, runtimeMinutes: 148, certificate: "PG-13", plot: "Dreams, within dreams.", director: ["Christopher Nolan"], stars: ["A", "B"] });
+    const rows = moviesToCsv([
+      watched("Inception", ["Mind-bending", "Fun"], { loved: true, now: Date.UTC(2024, 0, 5), info }),
+      later("Dune", Date.UTC(2023, 5, 1)),
+    ]).trim().split("\r\n");
+    assert.equal(rows.length, 3);
+    assert.equal(rows[1], 'Inception,watched,yes,Mind-bending; Fun,2010,148,PG-13,Christopher Nolan,A; B,"Dreams, within dreams.",2024-01-05,2024-01-05');
+    assert.equal(rows[2], "Dune,watchlist,no,,,,,,,,2023-06-01,");
+  });
+
+  test("escapes quotes and neutralises spreadsheet formulas", () => {
+    const csv = moviesToCsv([watched('Say "Hi"', ["x"], { now: 2 }), watched("=SUM(A1)", ["x"], { now: 1 })]);
+    const rows = csv.trim().split("\r\n");
+    assert.ok(rows[1].startsWith('"Say ""Hi"""'));
+    assert.ok(rows[2].startsWith("'=SUM(A1),"));
+  });
+});
