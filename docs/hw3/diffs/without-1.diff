+
+describe("CSV export", () => {
+  test("csvField quotes commas, quotes and newlines", () => {
+    assert.equal(csvField("plain"), "plain");
+    assert.equal(csvField("a,b"), '"a,b"');
+    assert.equal(csvField('say "hi"'), '"say ""hi"""');
+    assert.equal(csvField("two\nlines"), '"two\nlines"');
+    assert.equal(csvField(null), "");
+  });
+
+  test("csvField defuses spreadsheet formulas", () => {
+    assert.equal(csvField("=SUM(A1)"), "'=SUM(A1)");
+    assert.equal(csvField("@cmd"), "'@cmd");
+  });
+
+  test("an empty list is just the header", () => {
+    assert.equal(moviesToCsv([]), CSV_COLUMNS.join(",") + "\r\n");
+  });
+
+  test("exports watched and watchlist movies, with details and who it was watched with", () => {
+    const seen = watched("Dune, Part Two", ["WTF", "Sci-fi"], {
+      now: Date.UTC(2024, 2, 5),
+      loved: true,
+      info: readInfo({ year: 2024, runtimeMinutes: 166, certificate: "PG-13", plot: 'A "big" one', director: ["Denis Villeneuve"], stars: ["A", "B"] }),
+    });
+    seen.watchedWith = [{ with: "u1", at: 1 }];
+    const saved = later("Alien", Date.UTC(2024, 0, 1));
+    const lines = moviesToCsv([saved, seen], (id) => ({ u1: "Sam" })[id]).split("\r\n");
+    assert.equal(lines.length, 4);
+    assert.equal(lines[0], CSV_COLUMNS.join(","));
+    assert.equal(lines[1], '"Dune, Part Two",watched,yes,WTF; Sci-fi,2024,166,PG-13,Denis Villeneuve,A; B,"A ""big"" one",2024-03-05,2024-03-05,Sam');
+    assert.equal(lines[2], "Alien,watchlist,no,,,,,,,,2024-01-01,,");
+    assert.equal(lines[3], "");
+  });
+});
