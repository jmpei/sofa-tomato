+// Saves all movies as a CSV file through a temporary download link.
+function downloadCsv(movies, nameOf) {
+  const blob = new Blob(["﻿", moviesToCsv(movies, nameOf)], { type: "text/csv;charset=utf-8" });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement("a");
+  link.href = url;
+  link.download = "my-movies.csv";
+  document.body.appendChild(link);
+  link.click();
+  link.remove();
+  URL.revokeObjectURL(url);
+}
