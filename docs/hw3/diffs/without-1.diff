+// ---------- CSV export ----------
+
+export const CSV_COLUMNS = [
+  "Title", "Status", "Loved", "Tags", "Year", "Runtime (min)", "Certificate",
+  "Director", "Stars", "Plot", "Added", "Watched", "Watched with",
+];
+
+// One CSV field. Quotes when needed, and prefixes an apostrophe to text a
+// spreadsheet would run as a formula (=, +, -, @).
+export function csvField(value) {
+  let text = value == null ? "" : String(value);
+  if (/^[=+\-@\t\r]/.test(text)) text = `'${text}`;
+  return /[",\r\n]/.test(text) ? `"${text.replace(/"/g, '""')}"` : text;
+}
+
+const isoDate = (timestamp) => (Number.isFinite(timestamp) ? new Date(timestamp).toISOString().slice(0, 10) : "");
+
+// Every movie, watched and watchlist, as CSV text (CRLF rows, header first).
+// nameOf turns a "watched with" id into a name.
+export function moviesToCsv(movies, nameOf = (id) => id) {
+  const rows = sortNewestFirst(movies).map((m) => {
+    const info = m.info?.found ? m.info : null;
+    return [
+      m.title,
+      m.status,
+      m.loved ? "yes" : "no",
+      m.tags.join("; "),
+      info?.year ?? "",
+      info?.runtimeMinutes ?? "",
+      info?.certificate ?? "",
+      info?.director.join("; ") ?? "",
+      info?.stars.join("; ") ?? "",
+      info?.plot ?? "",
+      isoDate(m.createdAt),
+      m.status === "watched" ? isoDate(m.watchedAt ?? m.createdAt) : "",
+      m.watchedWith.map((w) => nameOf(w.with)).join("; "),
+    ];
+  });
+  return [CSV_COLUMNS, ...rows].map((row) => row.map(csvField).join(",")).join("\r\n") + "\r\n";
+}
